# ─────────────────────────────────────────────────────────────────────────────
# Jango.us environment variables
# Copy this file to ".env" for local non-Replit development, or set these as
# environment variables in your host (Railway, Render, Fly.io, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# On Railway, add a PostgreSQL plugin and use the provided connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED when hosting OFF Replit (Railway/Render/Fly.io/self-hosted).
# Selects the standard node-postgres driver. Leave UNSET on Replit (it uses the
# Neon serverless driver by default).
DATABASE_DRIVER=pg

# Optional — set to "false" only when connecting to a local Postgres without SSL.
# Defaults to SSL on (with rejectUnauthorized:false) for remote hosts.
# DATABASE_SSL=false

# REQUIRED — long random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Set automatically by most hosts. Defaults to 5000 if unset.
# PORT=5000

# Should be "production" in deployment so secure cookies are enabled.
NODE_ENV=production

# ── Payments (optional — leave unset to disable deposit/withdrawal features) ──
# Stripe (card payments)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# NOWPayments (cryptocurrency payments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=
